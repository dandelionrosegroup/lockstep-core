{
  "manifest_version": "0.4",
  "name": "lockstep-core",
  "display_name": "Lockstep Core",
  "version": "0.2.0",
  "description": "Chain-based project tracking for Human+AI collaboration. Structured session management with chains, tickets, capacity tracking, and session telemetry. Neurodivergent-first design with progressive disclosure and YAML-defined chain types.",
  "author": {
    "name": "Jack Daniel Williams / Dandelion Rose Group, LLC",
    "url": "https://github.com/dandelionrosegroup/lockstep-core"
  },
  "license": "GPL-3.0-or-later",
  "privacy_policies": [
    "https://dandelionrosegroup.github.io/lockstep-core/privacy"
  ],
  "server": {
    "type": "uv",
    "entry_point": "src/server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run", "--python", "3.11", "--with", "mcp>=1.0.0", "--with", "pydantic>=2.0.0", "--with", "PyYAML>=6.0", "src/server.py"],
      "env": {
        "LOCKSTEP_DATA_DIR": "${user_config.data_directory}"
      },
      "platform_overrides": {
        "darwin": {
          "env": {
            "PATH": "/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:${HOME}/.local/bin"
          }
        },
        "linux": {
          "env": {
            "PATH": "/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${HOME}/.local/bin"
          }
        }
      }
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"]
  },
  "user_config": {
    "data_directory": {
      "type": "directory",
      "title": "Data Directory",
      "description": "Where Lockstep stores chains, tickets, and capacity data",
      "required": true,
      "default": "${HOME}/.lockstep/data"
    }
  }
}
